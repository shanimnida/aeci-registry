# Scanned paper forms — personal data under RA 10173. NEVER commit these.
data/scanned-forms/
*.jpg
*.jpeg
*.png
*.heic
*.pdf

# ...but the church's own seal is branding, not member data. It has to
# ship or the deployed site has no logo. Scoped to that one directory so
# the blanket image rule above still catches a photographed form dropped
# anywhere else in the project.
!static/aegis/*.png

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Django
*.sqlite3
/media/
/staticfiles/
db.dump

# Database backups — a church member register, never committed
/backups/
*.sql
*.sql.gz
*.partial

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# SDD scratch workspace
.superpowers/

# Photographed member forms — personal data, NEVER commit
/form images/
*.HEIC
*.JPG
*.JPEG
*.PNG
*.PDF

# Filled member data as spreadsheets — Google Forms exports, AI transcription
# sheets, anything produced from `form images/`. Same rule as the scans: this
# is members' personal data under RA 10173 and never belongs in git. The one
# exception is data/officers.csv, which holds governance facts from Board
# minutes (names and committees of officers), not members' private details.
*.xlsx
*.xls
*.csv
!data/officers.csv
*(Responses)*
