DEBUG=True
SECRET_KEY=dev-only-not-for-production
DATABASE_URL=postgres://aeci:aeci@localhost:5432/aeci
ALLOWED_HOSTS=localhost,127.0.0.1

# Path (or bare command name) to the pg_dump binary used by the
# backup_database management command. Defaults to "pg_dump", which works
# when PostgreSQL's bin directory is on PATH. A stock Windows install does
# NOT add it to PATH, so on Windows set this to the full path, e.g.:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_DUMP_PATH=pg_dump

# When true, backup_database also uploads the compressed dump through the
# STORAGES["default"] backend (under a backups/ key prefix), same as scan
# images. Defaults to whatever USE_S3_STORAGE is set to. A local disk dump
# on a host whose filesystem resets on redeploy is not a real backup.
# BACKUP_TO_STORAGE=True

# Local and uploaded backups older than this are deleted after each run —
# except the single newest one, which is always kept regardless of age.
# BACKUP_RETENTION_DAYS=30
