DEBUG=True
SECRET_KEY=dev-only-not-for-production
DATABASE_URL=postgres://aeci:aeci@localhost:5432/aeci
ALLOWED_HOSTS=localhost,127.0.0.1

# Path (or bare command name) to the pg_dump binary used by the
# backup_database management command. Defaults to "pg_dump", which works
# when PostgreSQL's bin directory is on PATH. A stock Windows install does
# NOT add it to PATH, so on Windows set this to the full path, e.g.:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_DUMP_PATH=pg_dump
